# Project AIR Environment Configuration

# AI Engine (Google Gemini Vision)
# Configure current-generation model as required by BRD v2.1
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Security & Tokens
# Secret key used for HMAC-SHA256 signed QR codes for Site Supervisors
JWT_SECRET=super_secret_air_construction_key_2026

# Database & Storage
# Local SQLite database (mimicking Cloudflare D1 edge relational engine)
DATABASE_PATH=./account_ai.db
# Local file storage for DO photos and Invoices (mimicking Cloudflare R2 bucket)
STORAGE_DIR=./storage

# Tolerance & Matching Rules
# Configurable variance tolerance (0.02 = +/-2% for bulk materials like gravel/cement)
QUANTITY_TOLERANCE_PCT=0.02
PRICE_TOLERANCE_PCT=0.00
# Threshold below which extractions are routed to human review (0.85 = 85%)
CONFIDENCE_THRESHOLD=0.85

# Server & Ports
PORT=8000
FRONTEND_PORT=5173
