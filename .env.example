# Project AIR Environment Configuration

# AI Engine (Google Gemini Vision)
# Configure current-generation model as required by BRD v2.1
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Security & Tokens
# Secret key used for HMAC-SHA256 signed QR codes for Site Supervisors
JWT_SECRET=super_secret_air_construction_key_2026

# Database & Storage
# Local SQLite database or Cloudflare D1 (edge relational engine)
DATABASE_PATH=./account_ai.db

# Storage Provider: 'local' (default) or 'r2' (Cloudflare R2 Object Storage)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Cloudflare R2 Configuration (S3-compatible, zero egress fees)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=project-air-documents
R2_PUBLIC_URL=https://pub-your_bucket_hash.r2.dev

# Tolerance & Matching Rules
# Configurable variance tolerance (0.02 = +/-2% for bulk materials like gravel/cement)
QUANTITY_TOLERANCE_PCT=0.02
PRICE_TOLERANCE_PCT=0.00
# Threshold below which extractions are routed to human review (0.85 = 85%)
CONFIDENCE_THRESHOLD=0.85

# Server & Ports
PORT=8000
FRONTEND_PORT=5173
